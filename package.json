{
  "name": "bestvina-handel-web",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive visualization of the Bestvina–Handel algorithm for surface homeomorphisms, in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && eslint . && vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bits-ui": "^2.19.3",
    "jspdf": "^4.2.1",
    "ml-matrix": "^6.15.0",
    "paneforge": "^1.0.2",
    "svelte": "^5.57.1",
    "svg2pdf.js": "^2.8.1"
  }
}
